project Sample is

   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use ".";
   for Main        use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnatQ");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-j0");
   end Builder;

end Sample;
